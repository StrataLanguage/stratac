// implicit heap allocation via borrowing and move.
//
// When the target type is a box<T>, the compiler allocates the object on the heap via host-provided allocation funuctions. 
// Boxes are move-only (cannot be copied), are dropped (freed) at scope end, and ownership can be transferred by returning / assigning /
// passing as an owned parameter.

struct Vec3 {
    float x;
    float y;
    float z;
};


// ---------------------------------------------------------------------------
// box<T> v = T { ... };   allocates a T on the heap, stores the value,
//                          and auto-frees v when it goes out of scope.

float read_box()
{
    box<Vec3> v = Vec3 { .x = 1.0, .y = 2.0, .z = 3.0 };
    v.x = 10.0;
    return v.x + v.y + v.z;     // 10 + 2 + 3 = 15   (v freed at '}')
}

// `return v` *moves* the box out of the callee — the callee does NOT free
// it.  The caller receives ownership and frees it at its own scope end.

box<Vec3> make_vec3(float x, float y, float z)
{
    box<Vec3> v = Vec3 { .x = x, .y = y, .z = z };
    return v;   // moves out — caller now owns
}

// ---------------------------------------------------------------------------
// Move-assign (a = b) — frees the old box, takes the new pointer, nulls b
// ---------------------------------------------------------------------------
// `a = b` where both are box<T>:
//   1.  a's old box is freed (strata_free).
//   2.  b's pointer is copied into a.
//   3.  b is nulled — using b afterwards is a compile error ("use of moved box").

float move_and_read()
{
    box<Vec3> a = Vec3 { .x = 1.0, .y = 0.0, .z = 0.0 };
    box<Vec3> b = Vec3 { .x = 0.0, .y = 7.0, .z = 0.0 };
    a = b;                  // a's old box freed; b nulled (moved)
    return a.y;             // 7
}

// b is now unusable — the compiler rejects any use of a moved box.

// ---------------------------------------------------------------------------
// Owned box parameter — callee takes ownership, frees at return
// ---------------------------------------------------------------------------
// Passing a box as a plain box<T> parameter *moves* the caller's box.
// The callee owns it now and frees it when it returns.

float consume_box(box<Vec3> v)
{
    float s = v.x + v.y + v.z;
    return s;               // v freed here (owned param drop)
}

// ---------------------------------------------------------------------------
// Borrow parameter (ref box<T>) — callee reads, caller keeps owning
// ---------------------------------------------------------------------------
// Passing a box as `ref box<T>` is a borrow: the pointer is handed to the
// callee, but ownership stays with the caller.  No copy, no move.

float read_through_ref(ref box<Vec3> v)
{
    return v.x + v.y + v.z; // v is NOT freed here (borrow)
}

// ---------------------------------------------------------------------------
// Passing box data to the host via an `extern` function
// ---------------------------------------------------------------------------
// The host reads box data through a regular struct parameter (by-ref).
// Construct a stack struct from the box fields — the host receives a
// `const Vec3*` and does not touch the box.  See hosts/box_demo_host.c.

extern float host_length_sq(const Vec3 v);

// ---------------------------------------------------------------------------
// Entry point — ties everything together
// ---------------------------------------------------------------------------

float entry()
{
    box<Vec3> v = make_vec3(1.0, 2.0, 0.0);   // factory return — caller owns

    float a = read_through_ref(v);             // borrow — v stays alive
    v.y = 4.0;                                 // mutate through the borrow
    // Host sees a stack copy of the box data — safe borrow, no ownership transfer.
    float b = host_length_sq(Vec3 { .x = v.x, .y = v.y, .z = v.z });

    box<Vec3> w = make_vec3(0.0, 3.0, 4.0);
    float d = consume_box(w);                  // owned param — w moved, callee frees
    // w is now moved — using it would be a compile error

    return a + b + d;   // (1+2+0=3) + (1*1+4*4+0*0=17) + (0+3+4=7) = 27
}
