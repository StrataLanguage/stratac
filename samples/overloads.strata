// overloads.strata -- type-based overload resolution.
//
// Several functions share the name `length`; each call picks the one whose
// parameter types best match the arguments (exact match preferred; numeric
// conversions allowed with lower priority). Straight-line code, so it runs
// through the native back-end:
//   stratac overloads.strata -o overloads.o
//   stratac --ast overloads.strata  # see mangled symbols in the AST
//   clang overloads.o -o overloads.exe && ./overloads.exe ; echo $?   # 15

struct Vec3 {
    float x;
    float y;
    float z;
};

// Three overloads of `length`, distinguished by parameter type.
float length(int n) {
    return n;                       // a count, widened to float
}

float length(float s) {
    return s;                       // pass-through for a scalar
}

float length(in Vec3 v) {
    return v.x + v.y + v.z;         // sum of components (a stand-in for magnitude)
}

int main() {
    float a = length(7);            // int    arg -> length$int    -> 7.0
    float b = length(2.0);          // float  arg -> length$float  -> 2.0
    Vec3 v;
    v.x = 1.0;
    v.y = 2.0;
    v.z = 3.0;
    float c = length(v);            // Vec3   arg -> length$Vec3   -> 6.0
    return a + b + c;               // 7 + 2 + 6 = 15
}
