// string — owning heap-allocated string type.
//
//   string s = "hello";       // heap-copies the literal
//   s = "world";              // frees old buffer, copies new
//   return s;                 // moves ownership to caller
//   puts(s);                  // extern string params receive const char*

extern int puts(string s);

// --- Creation / move on return ---
string make_greeting()
{
    string s = "Hello, World!";
    return s;
}

// --- Reassignment ---
string replace_string()
{
    string s = "first";
    s = "second";
    return s;
}

// --- Owning param ---
int take_string(string s)
{
    return 1;
}

string globalString = "Test global";

^string boxedString = "Hello!";
^string[] arrayOfBoxedStrings;

string? nullableString = "Hi";

int run()
{
    puts(boxedString);
    puts(globalString);

    puts(nullableString);

    array_push(arrayOfBoxedStrings, "hi");
    puts(arrayOfBoxedStrings[0]);

    string g = make_greeting();   // owns "Hello, World!"
    puts(g);                      // prints it
    int x = take_string(g);       // moves g
    string r = replace_string();  // "second"
    int y = take_string(r);       // moves r
    return 5 + x + y;             // 7
}
