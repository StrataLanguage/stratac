// hello.strata -- Strata in a nutshell.
//
// No control flow, so this compiles and runs through *every* path:
//   stratac --emit ir  hello.strata                 # in-process LLVM IR
//   stratac --no-llvm --emit ir  hello.strata       # text IR
//   stratac --emit obj hello.strata -o hello.o      # native object
//   clang hello.o -o hello.exe && ./hello.exe ; echo $?   # runs, exit code 25

int add(int a, int b) {
    return a + b;
}

int mul(int a, int b) {
    return a * b;
}

// The host invokes this entry point.
int main() {
    return add(2, 3) + mul(4, 5);   // 5 + 20 = 25
}
