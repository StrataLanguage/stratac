import ../../std/bytebuffer;
import ../../std/math;

extern int printf(string fmt, ...);

struct test { int value; }

impl test {
	void Init(ref test self, int value)
	{
		self.value = value;
		printf("Hello\n");
	}

	void Drop(ref test self) {
		printf("goodbye %d\n", self.value);
	}


}

int main()
{
	const float x = -20.0f;
	const float res = sign(x);

	printf("res: %f\n", res);

	var t = test(20);

