int main()
{
// 	{
// 		rc<Context> cv = rc<Context>();
// // 		^Context ctx = Context {.x = 10, .y = 20.0f, .z = "[fart]"};
// //
// // 		^Any[] anys;
// // 		array_push(anys, (^Any)ctx);
//
// 		// call_lambda<Context>(ctx);
// 		return 0;
// 	}



	s.compiler = strataCompilerCreate();
	repl_install_panic_hook();

	s.decls = bytebuffer(256);
	s.src = bytebuffer(1024);
	s.input = bytebuffer(256);
	s.line = bytebuffer(256);
	s.body = bytebuffer(256);
	s.scratch = bytebuffer(256);
	s.file = bytebuffer(256);
	s.path = bytebuffer(256);
	s.session_name = bytebuffer(64);
	s.session_file = bytebuffer(256);

	cstring std_dir = "../../std";
	ptr std_env = getenv("STRATA_STD");
	if (std_env != ptr.null) {
		std_dir = (cstring)std_env;
	}

	strataAddImportDir(s.compiler, std_dir);

	cstring tmp_dir = "/tmp";

	ptr tmp_env = getenv("TMPDIR");

	if (tmp_env != ptr.null) {
		tmp_dir = (cstring)tmp_env;
	}

	s.session_name.write("strata_repl_");

	write_long(s.session_name, (long)getpid());
	s.session_name.write(".strata");
	s.session_file.write(tmp_dir);
	s.session_file.write("/");
	s.session_file.write(s.session_name.as_cstring());

	printf("Strata REPL. :help for help, :quit to leave.\n");

	line_edit edit;

	while (read_entry(edit)) {
		cstring t = s.input.as_cstring();
		ulong start = skip_space(t, 0);

		if (start >= t.length) {
			continue;
		}

		if (t[start] == ':') {
			if (run_command(t)) {
				break;
			}
			continue;
		}

		handle_entry(t);
	}

	strataCompilerDestroy(s.compiler);
	return 0;
}
