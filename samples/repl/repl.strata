// An interactive REPL for Strata, written in Strata.
//
// Each entry is compiled by the Strata JIT and executed.
//
// Since Strata is a systems style language, there is no runtime values or function calls in the global scope.
// To make this more of a REPL, variables are tracked and the values are persisted between statements.
//
// Note that `import` in this REPL looks in the directory located at STRATA_STD (default ../../std).

import ../../std/bytebuffer;
import ../../std/stringutil;
import ../../std/rc;


import repl_tui;

extern ptr getenv(cstring name);
extern int getpid();
extern ptr fopen(cstring path, cstring mode);
extern ulong fwrite(ptr data, ulong size, ulong count, ptr file);
extern int fgetc(ptr file);
extern int fclose(ptr file);
extern int unlink(cstring path);
extern ptr dlopen(ptr path, int mode);
extern ptr dlsym(ptr handle, cstring name);

extern ptr strataCompilerCreate();
extern void strataCompilerDestroy(ptr c);
extern int strataAddImportDir(ptr c, cstring dir);
extern ptr strataJitCompileFile(ptr c, cstring path, ptr err_out);
extern void strataJitDestroy(ptr jit);
extern ptr strataJitGetFunction(ptr jit, cstring name);
extern int strataJitAddSymbol(ptr jit, cstring name, ptr fn);
extern ulong strataJitGetExternSymbolCount(ptr jit);
extern cstring strataJitGetExternSymbolName(ptr jit, ulong index);
extern void strataFree(ptr s);

// shim.c
extern void repl_install_panic_hook();
extern int repl_run_guarded(ptr fn);
@export extern int repl_is_tty();
@export extern void repl_raw_on();
@export extern void repl_raw_off();

extern delegate ptr NewContextFn();
extern delegate void FreeContextFn(ptr ctx);
extern delegate long GetLongFn();
extern delegate double GetRealFn();

enum VarKind { NotVariable, Int, Long, Bool, Float, Double };
enum EntryKind { Item, Declaration, Expression, Statement };



// A variable kept for the session. Integers and bools use `ivalue`, floats `rvalue`.
struct Var
{
	string name;
	VarKind kind;
	long ivalue;
	double rvalue;
}

struct Session
{
	ptr compiler;

	Var[] vars;

	bytebuffer decls;        // kept declarations, in the order they were entered
	bytebuffer src;          // the module being compiled
	bytebuffer input;        // the entry being evaluated (may span lines)
	bytebuffer line;         // the line being read
	bytebuffer body;         // the body of __repl_run
	bytebuffer scratch;      // diagnostics and other text
	bytebuffer file;         // a file loaded with :load
	bytebuffer path;         // the path given to :load
	bytebuffer session_name; // this session's module file name
	bytebuffer session_file; // where the module is written for the compiler to read

	// Set while compiling a probe whose failure is expected and should stay silent.
	bool quiet;
}

Session s;


void clear(ref bytebuffer b)
{
	b.size = 0;
}

// Appends the bytes of t[from..to).
void add_range(ref bytebuffer b, cstring t, ulong from, ulong to)
{
	for (ulong i = from; i < to; i++) {
		b.write(t[i]);
	}
}

// Appends the bytes of an owned string.
void write_string(ref bytebuffer b, string text)
{
	for (ulong k = 0; k < text.length; k++) {
		b.write(text[k]);
	}
}

// The bytes of t[from..to) as an owned string.
string word_string(cstring t, ulong from, ulong to)
{
	clear(s.scratch);
	add_range(s.scratch, t, from, to);
	cstring text = s.scratch.as_cstring();
	string owned = text;
	return owned;
}

// A `long` as text, through C's snprintf.
void write_long(ref bytebuffer b, long value)
{
	byte[32] digits = {};
	*byte at = &digits[0];
	snprintf(at, 32, "%ld", value);
	b.write((cstring)digits);
}

// A double as a Strata float literal that reads back as the same value.
void write_real(ref bytebuffer b, double value)
{
	if (value != value) {
		b.write("(0.0 / 0.0)");
		return;
	}
	if (value > 1.0e308) {
		b.write("(1.0 / 0.0)");
		return;
	}
	if (value < -1.0e308) {
		b.write("(-1.0 / 0.0)");
		return;
	}

	byte[64] digits = {};
	*byte at = &digits[0];
	snprintf(at, 64, "%.17g", value);

	bool has_point = false;
	for (ulong i = 0; i < 64 && digits[i] != (byte)0; i++) {
		if (digits[i] == '.' || digits[i] == 'e' || digits[i] == 'E') {
			has_point = true;
		}
	}

	b.write((cstring)digits);
	if (!has_point) {
		b.write(".0");
	}
}

bool is_space(byte c)
{
	return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

bool is_word(byte c)
{
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

ulong skip_space(cstring t, ulong i)
{
	while (i < t.length && is_space(t[i])) {
		i++;
	}
	return i;
}

ulong word_end(cstring t, ulong i)
{
	while (i < t.length && is_word(t[i])) {
		i++;
	}
	return i;
}

// True when t[from..to) spells `word`.
bool word_is(cstring t, ulong from, ulong to, cstring word)
{
	if (to - from != word.length) {
		return false;
	}
	for (ulong k = 0; k < word.length; k++) {
		if (t[from + k] != word[k]) {
			return false;
		}
	}
	return true;
}

/////////////////////////////
// Variables

VarKind kind_of_type(cstring t, ulong from, ulong to)
{
	if (word_is(t, from, to, "int")) {
		return VarKind.Int;
	}
	if (word_is(t, from, to, "long")) {
		return VarKind.Long;
	}
	if (word_is(t, from, to, "bool")) {
		return VarKind.Bool;
	}
	if (word_is(t, from, to, "float")) {
		return VarKind.Float;
	}
	if (word_is(t, from, to, "double")) {
		return VarKind.Double;
	}
	return VarKind.NotVariable;
}

cstring kind_name(VarKind kind)
{
	if (kind == VarKind.Bool) {
		return "bool";
	}
	if (kind == VarKind.Long) {
		return "long";
	}
	if (kind == VarKind.Float) {
		return "float";
	}
	if (kind == VarKind.Double) {
		return "double";
	}
	return "int";
}

bool is_real(VarKind kind)
{
	return kind == VarKind.Float || kind == VarKind.Double;
}

// The index of the variable named `name`, or -1.
int find_var(string name)
{
	for (ulong i = 0; i < s.vars.length; i++) {
		if (s.vars[i].name == name) {
			return (int)i;
		}
	}
	return -1;
}

// Writes `TYPE name = value;` for variable i, with its value as of the last run.
void add_variable_decl(int i)
{
	s.src.write(kind_name(s.vars[i].kind));
	s.src.write(" ");
	write_string(s.src, s.vars[i].name);
	s.src.write(" = ");

	if (s.vars[i].kind == VarKind.Bool) {
		s.src.write(s.vars[i].ivalue != 0 ? "true" : "false");
	}
	else if (is_real(s.vars[i].kind)) {
		write_real(s.src, s.vars[i].rvalue);
	}
	else if (s.vars[i].kind == VarKind.Int) {
		string digits = to_str((int)s.vars[i].ivalue);
		write_string(s.src, digits);
	}
	else {
		write_long(s.src, s.vars[i].ivalue);
	}

	s.src.write(";\n");
}

// Writes the exported getter that reads variable i back after a run.
void add_getter(int i)
{
	if (is_real(s.vars[i].kind)) {
		s.src.write("@export double __repl_get_");
		write_string(s.src, s.vars[i].name);
		s.src.write("() { return (double)");
		write_string(s.src, s.vars[i].name);
		s.src.write("; }\n");
	}
	else if (s.vars[i].kind == VarKind.Bool) {
		s.src.write("@export long __repl_get_");
		write_string(s.src, s.vars[i].name);
		s.src.write("() { if (");
		write_string(s.src, s.vars[i].name);
		s.src.write(") { return 1; } return 0; }\n");
	}
	else {
		s.src.write("@export long __repl_get_");
		write_string(s.src, s.vars[i].name);
		s.src.write("() { return (long)");
		write_string(s.src, s.vars[i].name);
		s.src.write("; }\n");
	}
}

///////////////////////////
// Entry classification

bool is_item_word(cstring t, ulong from, ulong to)
{
	return word_is(t, from, to, "struct") || word_is(t, from, to, "impl")
		|| word_is(t, from, to, "extern") || word_is(t, from, to, "import")
		|| word_is(t, from, to, "delegate") || word_is(t, from, to, "handle")
		|| word_is(t, from, to, "union") || word_is(t, from, to, "enum");
}

bool is_statement_word(cstring t, ulong from, ulong to)
{
	return word_is(t, from, to, "return") || word_is(t, from, to, "if")
		|| word_is(t, from, to, "else") || word_is(t, from, to, "while")
		|| word_is(t, from, to, "for") || word_is(t, from, to, "do")
		|| word_is(t, from, to, "break") || word_is(t, from, to, "continue");
}


EntryKind classify(cstring t)
{
	ulong start = skip_space(t, 0);

	if (t[start] == '@') {
		return EntryKind.Item;
	}

	ulong first_end = word_end(t, start);

	if (first_end > start && !is_statement_word(t, start, first_end)) {
		if (is_item_word(t, start, first_end)) {
			return EntryKind.Item;
		}

		ulong second = skip_space(t, first_end);
		ulong second_end = word_end(t, second);

		if (second_end > second) {
			ulong after = skip_space(t, second_end);

			if (after < t.length && t[after] == '(') {
				return EntryKind.Item;
			}
			if (after >= t.length || t[after] == '=' || t[after] == ';') {
				return EntryKind.Declaration;
			}
		}
	}

	ulong last = t.length;
	while (last > start && is_space(t[last - 1])) {
		last--;
	}

	if (t[last - 1] == ';' || t[last - 1] == '}') {
		return EntryKind.Statement;
	}
	return EntryKind.Expression;
}

// True when `t` is a declaration that still needs more text, such as a function
// header whose body is on the next line.
bool header_pending(cstring t)
{
	ulong start = skip_space(t, 0);
	if (start >= t.length) {
		return false;
	}

	ulong last = t.length;
	while (last > start && is_space(t[last - 1])) {
		last--;
	}

	if (t[last - 1] == ';' || t[last - 1] == '}') {
		return false;
	}
	return classify(t) == EntryKind.Item;
}

// Net count of open brackets on a line, ignoring string, char and // comment text.
int bracket_delta(cstring line)
{
	int depth = 0;
	bool in_string = false;
	byte quote = (byte)0;
	ulong i = 0;

	while (i < line.length) {
		byte c = line[i];

		if (in_string) {
			if (c == '\\') {
				i = i + 2;
				continue;
			}
			if (c == quote) {
				in_string = false;
			}
		}
		else if (c == '"' || c == '\'') {
			in_string = true;
			quote = c;
		}
		else if (c == '/' && i + 1 < line.length && line[i + 1] == '/') {
			break;
		}
		else if (c == '{' || c == '(' || c == '[') {
			depth++;
		}
		else if (c == '}' || c == ')' || c == ']') {
			depth--;
		}

		i++;
	}

	return depth;
}


const uint sc_max_prompt_length = 1024;
string build_prompt(bool first, int depth)
{
	if (first) {
		return ">>> ";
	}

	byte[sc_max_prompt_length] buffer = {};

	for (uint i = 0; i < depth + 1; i++) {
		const uint buffer_index = (i * 4);

		buffer[buffer_index] = '.';
		buffer[buffer_index + 1] = '.';
		buffer[buffer_index + 2] = '.';
		buffer[buffer_index + 3] = ' ';
	}

	return to_str(&buffer[0], sc_max_prompt_length);
}


// Reads one entry into s.input, continuing lines while brackets are open.
// Returns false at end of input.
bool read_entry(ref line_edit edit)
{
	clear(s.input);

	int depth = 0;
	bool first = true;


	while (true) {
		string prompt = build_prompt(first, depth);

		if (!read_line(edit, prompt)) {
			return !first;
		}

		if (!first) {
			s.input.write('\n');
		}
		s.input.write(s.line.as_cstring());
		first = false;

		depth = depth + bracket_delta(s.line.as_cstring());
		if (depth <= 0 && !header_pending(s.input.as_cstring())) {
			return true;
		}
	}
}

////////////////////////////////////////
// Building modules and compilation

void add_repl_internal_functions(ref bytebuffer b)
{
	b.write("extern int printf(cstring fmt, ...);\n");

	b.write("void __repl_show(int __repl_value) { printf(\"%d\\n\", __repl_value); }\n");
	b.write("void __repl_show(long __repl_value) { printf(\"%ld\\n\", __repl_value); }\n");
	b.write("void __repl_show(float __repl_value) { printf(\"%g\\n\", (double)__repl_value); }\n");
	b.write("void __repl_show(double __repl_value) { printf(\"%g\\n\", __repl_value); }\n");
	b.write("void __repl_show(bool __repl_value) { if (__repl_value) { printf(\"true\\n\"); } else { printf(\"false\\n\"); } }\n");
	b.write("void __repl_show(cstring __repl_value) { printf(\"\\\"%s\\\"\\n\", __repl_value); }\n");
	b.write("void __repl_show(string __repl_value) { printf(\"\\\"%s\\\"\\n\", __repl_value); }\n");
}

void build_module(cstring item, cstring body, bool run)
{
	clear(s.src);

	add_repl_internal_functions(s.src);

	for (int i = 0; i < (int)s.vars.length; i++) {
		add_variable_decl(i);
	}

	s.src.write(s.decls.as_cstring());
	s.src.write(item);
	s.src.write("\n");

	for (int i = 0; i < (int)s.vars.length; i++) {
		add_getter(i);
	}

	if (run) {
		s.src.write("@export void __repl_run() {\n");
		s.src.write(body);
		s.src.write("\n}\n");
	}
}

byte last_byte(ref bytebuffer b)
{
	cstring text = b.as_cstring();
	return text[text.length - 1];
}

void print_diagnostics(cstring diag)
{
	cstring name = s.session_name.as_cstring();
	ulong name_len = name.length;

	clear(s.scratch);

	ulong i = 0;

	const uint diag_length = diag.length;

	while (i < diag_length) {
		if (i + name_len <= diag_length && word_is(diag, i, i + name_len, name)) {
			// Drop the directory already copied: back to the last space or the start of the line.
			while (s.scratch.size > 0 && !is_space(last_byte(s.scratch))) {
				s.scratch.size = s.scratch.size - 1;
			}
			s.scratch.write("repl");
			i = i + name_len;
		}
		else {
			s.scratch.write(diag[i]);
			i++;
		}
	}

	printf("%s\n", s.scratch.as_cstring());
}

ptr compile_module()
{
	ptr file = fopen(s.session_file.as_cstring(), "w");
	if (file == ptr.null) {
		printf("error: cannot write %s\n", s.session_file.as_cstring());
		return ptr.null;
	}
	defer fclose(file);

	fwrite(s.src.get_ptr(), 1, s.src.size, file);
	fclose(file);

	cstring file_cstr = s.session_file.as_cstring();

	ptr err = ptr.null;
	ptr jit = strataJitCompileFile(s.compiler, file_cstr, &err);
	unlink(file_cstr);

	if (jit == ptr.null && !s.quiet) {
		print_diagnostics((cstring)err);
	}
	if (err != ptr.null) {
		strataFree(err);
	}

	return jit;
}

void bind_externs(ptr jit)
{
	ptr self = dlopen(ptr.null, 2);
	ulong count = strataJitGetExternSymbolCount(jit);

	for (ulong i = 0; i < count; i++) {
		cstring name = strataJitGetExternSymbolName(jit, i);
		strataJitAddSymbol(jit, name, dlsym(self, name));
	}
}

void execute(ptr jit)
{
	defer strataJitDestroy(jit);
	bind_externs(jit);

	NewContextFn new_context = (NewContextFn)strataJitGetFunction(jit, "__strata_context_create");
	var ctx = new_context();
	FreeContextFn free_context = (FreeContextFn)strataJitGetFunction(jit, "__strata_context_destroy");
	defer free_context(ctx);

	repl_run_guarded(strataJitGetFunction(jit, "__repl_run"));

	for (ulong i = 0; i < s.vars.length; i++) {
		clear(s.scratch);
		s.scratch.write("__repl_get_");
		write_string(s.scratch, s.vars[i].name);
		cstring getter = s.scratch.as_cstring();

		if (is_real(s.vars[i].kind)) {
			GetRealFn get = (GetRealFn)strataJitGetFunction(jit, getter);
			s.vars[i].rvalue = get();
		}
		else {
			GetLongFn get = (GetLongFn)strataJitGetFunction(jit, getter);
			s.vars[i].ivalue = get();
		}
	}
}

//////////////////////
// Evauluation


bool add_item(cstring item)
{
	build_module(item, "", false);

	ptr jit = compile_module();
	if (jit == ptr.null) {
		return false;
	}
	strataJitDestroy(jit);

	s.decls.write(item);
	s.decls.write("\n");
	return true;
}

void run_body(cstring body)
{
	build_module("", body, true);

	var jit = compile_module();
	if (jit != ptr.null) {
		execute(jit);
	}
}


void run_expression(cstring t)
{
	clear(s.body);
	s.body.write("__repl_show(");
	s.body.write(t);
	s.body.write(");");

	build_module("", s.body.as_cstring(), true);

	s.quiet = true;
	ptr jit = compile_module();
	s.quiet = false;

	if (jit != ptr.null) {
		execute(jit);
		return;
	}

	clear(s.body);
	s.body.write(t);
	s.body.write(";");
	run_body(s.body.as_cstring());
}


void declare_variable(cstring t)
{
	ulong type_start = skip_space(t, 0);
	ulong type_end = word_end(t, type_start);
	ulong name_start = skip_space(t, type_end);
	ulong name_end = word_end(t, name_start);

	var kind = kind_of_type(t, type_start, type_end);
	if (kind == VarKind.NotVariable) {
		printf("error: only int, long, bool, float and double variables are kept between entries\n");
		return;
	}

	var name = word_string(t, name_start, name_end);
	var index = find_var(name);
	var is_new = index < 0;

	if (is_new) {
		array_push(s.vars, Var { .name = name, .kind = kind, .ivalue = 0, .rvalue = 0.0 });
	}
	else if (s.vars[index].kind != kind) {
		printf("error: %s is already declared with another type\n", name);
		return;
	}

	// The declaration as an assignment: `name = expr;`, or `name = 0;` without one.
	clear(s.body);
	add_range(s.body, t, name_start, name_end);

	ulong after = skip_space(t, name_end);
	if (after < t.length && t[after] == '=') {
		add_range(s.body, t, name_end, t.length);

		// The `;` is optional at the prompt.
		ulong stop = t.length;
		while (stop > name_end && is_space(t[stop - 1])) {
			stop--;
		}
		if (t[stop - 1] != ';') {
			s.body.write(";");
		}
	}
	else {
		s.body.write(" = 0;");
	}

	build_module("", s.body.as_cstring(), true);

	var jit = compile_module();
	if (jit == ptr.null) {
		if (is_new) {
			Var rejected = array_pop(s.vars);
		}
		return;
	}
	execute(jit);
}

void handle_entry(cstring t)
{
	EntryKind kind = classify(t);

	if (kind == EntryKind.Item) {
		add_item(t);
	}
	else if (kind == EntryKind.Declaration) {
		declare_variable(t);
	}
	else if (kind == EntryKind.Statement) {
		run_body(t);
	}
	else {
		run_expression(t);
	}
}

//////////////////////
// Comands

void print_help()
{
	printf("=== Help ===\n");
	printf(":vars            list the variables\n");
	printf(":reset           forget all variables and kept declarations\n");
	printf(":load <file>     add the declarations in a file\n");
	printf(":help            show this message\n");
	printf(":quit            leave the REPL\n");
}


void print_vars()
{
	if (s.vars.length == 0) {
		printf("no variables\n");
		return;
	}

	for (ulong i = 0; i < s.vars.length; i++) {
		printf("%s %s = ", kind_name(s.vars[i].kind), s.vars[i].name);

		if (s.vars[i].kind == VarKind.Bool) {
			printf(s.vars[i].ivalue != 0 ? "true\n" : "false\n");
		}
		else if (is_real(s.vars[i].kind)) {
			printf("%g\n", s.vars[i].rvalue);
		}
		else {
			printf("%ld\n", s.vars[i].ivalue);
		}
	}
}

void reset_session()
{
	clear(s.decls);
	while (s.vars.length > 0) {
		Var gone = array_pop(s.vars);
	}
	printf("session cleared\n");
}

void load_file(cstring path)
{
	ptr file = fopen(path, "r");

	if (file == ptr.null) {
		printf("error: cannot open %s\n", path);
		return;
	}

	defer fclose(file);

	clear(s.file);
	int ch = fgetc(file);
	while (ch != -1) {
		s.file.write((byte)ch);
		ch = fgetc(file);
	}

	if (add_item(s.file.as_cstring())) {
		printf("loaded %s\n", path);
	}
}

// Runs a `:command`. Returns true when the REPL should exit.
bool run_command(cstring t)
{
	ulong start = skip_space(t, 0);
	ulong end = word_end(t, start + 1);

	if (word_is(t, start + 1, end, "quit") || word_is(t, start + 1, end, "q")) {
		return true;
	}
	else if (word_is(t, start + 1, end, "help")) {
		print_help();
	}
	else if (word_is(t, start + 1, end, "vars")) {
		print_vars();
	}
	else if (word_is(t, start + 1, end, "reset")) {
		reset_session();
	}
	else if (word_is(t, start + 1, end, "load")) {
		ulong arg = skip_space(t, end);
		ulong stop = t.length;
		while (stop > arg && is_space(t[stop - 1])) {
			stop--;
		}

		clear(s.path);
		add_range(s.path, t, arg, stop);
		load_file(s.path.as_cstring());
	}
	else {
		printf("unknown command (try :help)\n");
	}

	return false;
}


