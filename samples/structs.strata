struct Vec3
{
    float x;
    float y;
    float z;
};

float max(in Vec3 v)
{
    return max(v.x, max(v.y, v.z));
}

float max(float a, float b)
{
    if (a > b) return a;

    return b;
}

Vec3 add(in Vec3 a, in Vec3 b)
{
    Vec3 res;
    res.x = a.x + b.x;
    res.y = a.y + b.y;
    res.z = a.z + b.z;
    return res;
}

struct Particle
{
    int id;
    Vec3 pos;
    Vec3 vel;
    float mass;
};

float dot(in Vec3 a, in Vec3 b)
{
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

// Kinetic energy = 0.5 * m * |v|^2.
float kinetic_energy(in Particle p)
{
    float speed_sq = dot(p.vel, p.vel);
    return speed_sq * p.mass * 0.5;
}

float entry()
{
    Particle p;
    p.id   = 1;
    p.pos  = Vec3 { 0.0, 0.0, 0.0 };
    p.vel  = Vec3 { 3.0, 4.0, 0.0 };   // speed^2 = 9 + 16 = 25
    p.mass = 2.0;
    return kinetic_energy(p);        // 25 * 2.0 * 0.5 = 25.0
}

// For standalone
int main()
{
    Vec3 v = add(Vec3 { 1,2,3 }, Vec3 { 4,5,6 });

    return max(v);
}

