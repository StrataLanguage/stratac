// structs.strata — named struct types with fields, creation, and member access.

struct Vec3
{
    float x;
    float y;
    float z;
};

float dot(const Vec3 a, const Vec3 b)
{
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

Vec3 add(const Vec3 a, const Vec3 b)
{
    Vec3 res;
    res.x = a.x + b.x;
    res.y = a.y + b.y;
    res.z = a.z + b.z;
    return res;
}

struct Particle
{
    int   id;
    Vec3  pos;
    float mass;
};

int main()
{
    Vec3 v = add(Vec3 { 1, 2, 3 }, Vec3 { 4, 5, 6 });
    Particle p;
    p.id = 1;
    p.pos = v;
    p.mass = 1.0;
    return p.id;
}
