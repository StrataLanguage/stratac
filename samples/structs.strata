// structs.strata -- user-defined value types: fields, member access, positional
// construction, nested structs, and passing by reference.
//
// Struct parameters are always passed by reference (in/out/inout); copy
// explicitly if you need a local value. Straight-line code, so the native
// back-end lowers it fully:
//   stratac --emit ir   structs.strata
//   stratac --emit obj  structs.strata -o structs.o
//
// The host observes results through a scalar entry point (here, `entry`).

struct Vec3 {
    float x;
    float y;
    float z;
};

struct Particle {
    int   id;
    Vec3  pos;
    Vec3  vel;
    float mass;
};

float dot(in Vec3 a, in Vec3 b) {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

// Kinetic energy = 0.5 * m * |v|^2.
float kinetic_energy(in Particle p) {
    float speed_sq = dot(p.vel, p.vel);
    return speed_sq * p.mass * 0.5;
}

float entry() {
    Particle p;
    p.id   = 1;
    p.pos  = Vec3(0.0, 0.0, 0.0);
    p.vel  = Vec3(3.0, 4.0, 0.0);   // speed^2 = 9 + 16 = 25
    p.mass = 2.0;
    return kinetic_energy(p);        // 25 * 2.0 * 0.5 = 25.0
}
