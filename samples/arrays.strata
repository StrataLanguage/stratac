/* Arrays: a fat {ptr, uint len, uint cap} owning type. Length/capacity are
 * queried via .length / .cap.
 *
 * Inline array helpers (compiler intrinsics, polymorphic over the element
 * type at each call site):
 *   array_push(arr, value) -> uint   grow by one element; returns new length
 *   array_pop(arr)         -> T      remove and return the last element
 *   array_resize(arr, n)   -> void   grow (zero-init) or shrink (drop) to n
 *
 * Growth is amortized O(1): when out of room the buffer is reallocated at
 * double the capacity (seeding 4 off an empty array); push otherwise writes
 * in place.
 *
 * A struct holding any owning field (string/^T/T[]) is itself "owning" and
 * must be boxed - so an array of FooBars is written ^FooBar[]. Dropping a
 * ^FooBar frees the FooBar's string field recursively.
 */

int sum(ref int[] a)
{
    int total = 0;
    for (ulong i = 0; i < a.length; i = i + 1)
    {
        total = total + a[i];
    }
    
    return total;
}

/* Exercises array_push / array_pop / array_resize. */
int helpers()
{
    int[] a = {1, 2, 3};
    array_push(a, 4);            // {1, 2, 3, 4}
    array_push(a, 5);            // {1, 2, 3, 4, 5}
    int popped = array_pop(a);   // 5; a = {1, 2, 3, 4}

    int s = sum(a);              // 1 + 2 + 3 + 4 = 10

    array_resize(a, 2);          // {1, 2}
    int s2 = sum(a);             // 3

    array_resize(a, 4);          // {1, 2, 0, 0}
    int s3 = sum(a);             // 3

    return s + popped + s2 + s3 + (int)a.length;  // 10 + 5 + 3 + 3 + 4 = 25
}

struct FooBar
{
    string str;
    int[] ints;
    FooBar? next;
};

int[] testGlobalArray = {65, 100, 80};
string testGlobalString = "again";

extern int puts(string str);
extern int putchar(int ch);

void PrintAll(ref int[] elems)
{
    for (uint i = 0; i < elems.length; i++)
    {
        putchar(elems[i]);
    }
    puts("");
}

void maybe_mutate(ref int i)
{
++i;
}

void PrintAll(ref ^FooBar[] elems) {
    string foo1 = "hi";
    ^FooBar fb1 = {foo1};
    array_push(elems, fb1);
    if (elems[0].next?)
    {
        //array_push(elems, elems[0].next);   // narrowed T? moves into the ^T[] element slot

        int idx = 0;
        if (elems[idx].next?)
        {
            maybe_mutate(idx);

            if(elems[idx].next?)
            {
                puts(elems[idx].next.str);         // would NOT compile: elems[9] is a different element
            }
        }
    }

    array_push(elems, FooBar("again", {}, {}));
    array_push(elems, FooBar(copy(testGlobalString), {}, {}));
    for (uint i = 0; i < elems.length; i++) {
        puts(elems[i].str);
    }
}

int entry() {
    PrintAll(testGlobalArray);

    ^FooBar[] fooBars = { FooBar("hello", {}, { "ANOTHER ONE!" }), FooBar("world", {}, {}) };
    PrintAll(fooBars);

    int[] nums = {1, 2, 3, 4, 5};
    nums[0] = 10;

    return sum(nums) + (int)nums.length + helpers();  // 29 + 25 = 54
}
