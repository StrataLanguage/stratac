/* Arrays: a fat {ptr, u64} owning type. Length is queried via .length.
 *
 * Inline array helpers (compiler intrinsics, polymorphic over the element
 * type at each call site):
 *   array_push(arr, value) -> ulong  grow by one element; returns new length
 *   array_pop(arr)         -> T      remove and return the last element
 *   array_resize(arr, n)   -> void   grow (zero-init) or shrink (drop) to n
 *
 * A struct holding any owning field (string/box<T>/T[]) is itself "owning" and
 * must be boxed - so an array of FooBars is written box<FooBar>[]. Dropping a
 * box<FooBar> frees the FooBar's string field recursively.
 */

int sum(ref int[] a)
{
    int total = 0;
    for (ulong i = 0; i < a.length; i = i + 1)
    {
        total = total + a[i];
    }
    
    return total;
}

/* Exercises array_push / array_pop / array_resize. */
int helpers()
{
    int[] a = {1, 2, 3};
    array_push(a, 4);            // {1, 2, 3, 4}
    array_push(a, 5);            // {1, 2, 3, 4, 5}
    int popped = array_pop(a);   // 5; a = {1, 2, 3, 4}

    int s = sum(a);              // 1 + 2 + 3 + 4 = 10

    array_resize(a, 2);          // {1, 2}
    int s2 = sum(a);             // 3

    array_resize(a, 4);          // {1, 2, 0, 0}
    int s3 = sum(a);             // 3

    return s + popped + s2 + s3 + (int)a.length;  // 10 + 5 + 3 + 3 + 4 = 25
}

struct FooBar
{
    string str;
};

int[] testGlobalArray = {65, 100, 80};
string testGlobalString = "again";

extern int puts(string str);
extern int putchar(int ch);

void PrintAll(ref int[] elems)
{
    for (uint i = 0; i < elems.length; i++)
    {
        putchar(elems[i]);
    }
    puts("");
}

void PrintAll(ref box<FooBar>[] elems) {
    //string localCopy = testGlobalString;
    /// FAILS TO COMPILE! (cannot be moved as it is not owned):    array_push(elems, FooBar(localCopy));   // {hello, world, again}
    /// CRASHES!     array_push(elems, FooBar(testGlobalString));   // {hello, world, again}
    array_push(elems, FooBar("again"));   // {hello, world, again}
    for (uint i = 0; i < elems.length; i++) {
        puts(elems[i].str);
    }
}

int entry() {
    PrintAll(testGlobalArray);

    box<FooBar>[] fooBars = { FooBar("hello"), FooBar("world") };
    PrintAll(fooBars);

    int[] nums = {1, 2, 3, 4, 5};
    nums[0] = 10;

    return sum(nums) + (int)nums.length + helpers();  // 29 + 25 = 54
}
