// engine_api.strata — opaque engine handles cross the host boundary.
//
// The engine owns the Entity layout; Strata holds pointer-sized handles
// and calls engine functions on them.  See hosts/engine_api_host.c.

handle Entity;

extern Entity world_spawn(int x, int y);
extern void   world_move(Entity e, int dx, int dy);
extern int    world_x(Entity e);
extern int    world_y(Entity e);
extern void   world_destroy(Entity e);

int run()
{
    Entity e = world_spawn(10, 20);
    world_move(e, -19, 0);         // x = 10 - 19 = -9
    int x = world_x(e);
    world_destroy(e);
    return x;                      // -9
}
