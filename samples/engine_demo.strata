// engine_demo.strata -- a game-AI script used in BOTH JIT and AOT modes.
//
// The SAME script file is either:
//   - loaded and JIT-compiled at runtime (USE_JIT), or
//   - pre-compiled to an object and linked into the executable (AOT / ship).
// See hosts/engine_demo_host.c (conditional #ifdef USE_JIT) and
// run_engine_demo.bat.


import imports/weapons/pistol;

string[] gStr;

handle Entity;

extern Entity spawn(int x, int y);
extern void   destroy(Entity e);
extern int    get_x(Entity e);
extern int    get_y(Entity e);
extern void   move(Entity e, int dx, int dy);

void TakeOwnershipOfBox(^Pistol p)
{
}

void BorrowBox(ref ^Pistol p)
{
}

struct Any;
struct Wrapper { ^Any target; };

extern int printf(string str, ...);

struct EWeaponType = uint;
const EWeaponType Gun = (EWeaponType)0;
const EWeaponType Melee = (EWeaponType)1;

void foo()
{
    printf("Gun = %u\n", (uint)Gun);
    printf("Melee = %u\n", (uint)Melee);
    const EWeaponType myWeaponType = Gun;

}


int chase(Entity attacker, Entity target, int step)
{
    array_push(gStr, "123");
    printf("gStr[0] = %s\n", gStr[0]);

    ^Pistol p = MakePistol(100);
    ^Wrapper wrapper = { (^Any)p };

    int ax = get_x(attacker);
    int ay = get_y(attacker);
    int tx = get_x(target);
    int ty = get_y(target);
    
    for (int i = 0; i < 10; i++)
    {
        Shoot((^Pistol)wrapper.target);


        //BorrowBox(p);

        int dx = step;
        int dy = step;
        if (tx < ax) { dx = 0 - step; }
        if (ty < ay) { dy = 0 - step; }

        move(attacker, dx, dy);
    }

    Shoot((^Pistol)wrapper.target);

    return get_x(attacker) + get_y(attacker);
}
