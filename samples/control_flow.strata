// control_flow.strata — if/else, while, for, break/continue, recursion.

int factorial(int n)
{
    int result = 1;
    int i = 1;
    while (i <= n)
    {
        result = result * i;
        i = i + 1;
    }
    return result;
}

int fibonacci(int n)
{
    if (n < 2) { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

int sum_skipping_fives(int n)
{
    int total = 0;
    int i = 0;
    while (true)
    {
        i = i + 1;
        if (i > n) { break; }
        if (i == 5 || i == 10) { continue; }
        total = total + i;
    }
    return total;
}

int main()
{
    int f = factorial(5);            // 120
    int fib = fibonacci(10);         // 55
    int skip = sum_skipping_fives(10); // 1..10 minus 5,10 = 40
    return f + fib + skip;           // 215
}
