// control_flow.strata -- control flow and out/inout parameters.
//
// Now lowers through BOTH back-ends (the native back-end handles if/else,
// while, for, break/continue, recursion, and out/inout). Run it natively:
//   stratac --emit obj control_flow.strata -o control_flow.o
//   clang control_flow.o -o control_flow.exe && ./control_flow.exe ; echo $?
// Or inspect as text IR:
//   stratac --no-llvm --emit ir control_flow.strata

// Iterative factorial with a while loop.
int factorial(int n) {
    int result = 1;
    int i = 1;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

// A for loop: sum of squares 1*1 + 2*2 + ... + n*n.
int sum_squares(int n) {
    int total = 0;
    for (int i = 1; i <= n; i = i + 1) {
        total = total + i * i;
    }
    return total;
}

// Recursive Fibonacci.
int fibonacci(int n) {
    if (n < 2) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// break and continue: sum of 1..n, skipping multiples of 5.
int sum_skipping_fives(int n) {
    int total = 0;
    int i = 0;
    while (true) {
        i = i + 1;
        if (i > n) { break; }
        if (i == 5 || i == 10) { continue; }
        total = total + i;
    }
    return total;
}

// out parameters hand values back to the caller (there are no pointers in
// Strata; out/inout are lowered to pointers internally).
void minmax(int a, int b, out int lo, out int hi) {
    if (a < b) { lo = a; hi = b; } else { lo = b; hi = a; }
}

int main() {
    int f = factorial(5);          // 120
    int s = sum_squares(4);        // 30
    int fib = fibonacci(10);       // 55
    int skip = sum_skipping_fives(10); // 1..10 minus 5,10 = 40
    int lo;
    int hi;
    minmax(7, 3, lo, hi);          // lo = 3, hi = 7
    return f + s + fib + skip + lo + hi;  // 120 + 30 + 55 + 40 + 3 + 7 = 255
}
