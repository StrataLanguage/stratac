// extern_math.strata -- Strata calling host-provided (extern) functions.
//
// The host program supplies rand_seed / rand_next / clamp_int (see
// hosts/extern_math_host.c). This is the "script calls into the engine" pattern.
//
// Build and run the whole thing (AOT object linked against the host):
//   stratac --emit obj extern_math.strata -o extern_math.o
//   clang hosts/extern_math_host.c extern_math.o -o extern_math.exe
//   ./extern_math.exe

extern int rand_seed(int s);
extern int rand_next();
extern int clamp_int(int value, int lo, int hi);

// A seeded "lucky number" clamped to [0, 99].
int lucky_number(int seed) {
    rand_seed(seed);
    int r = rand_next();
    return clamp_int(r, 0, 99);
}
