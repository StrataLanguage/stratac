// simd.strata - SIMD vector sample.
//
// float3 / float4 are 128-bit SIMD vectors. They support per-lane arithmetic
// (+, -, *, /), construction float3(x, y, z), splatting float3(s), swizzles
// (.xyz, .zyx, .yyy, ...), and single-lane reads (.x, .y, .z, .w).
//
// The C backend lowers these to SSE intrinsics (x64) or NEON (arm64) when SIMD
// is enabled, or to a plain __strata_float128 struct otherwise (used by the JIT).

float3 add(ref float3 a, ref float3 b)
{
    return a + b;
}

extern int printf(string fmt, ...);

void print_vector(float3 inVec)
{
    printf("x=%f, y=%f, z=%f\n", inVec.x, inVec.y, inVec.z);
}

void print_vectors(ref box<float3>... vecs)
{
    for (uint i = 0; i < vecs.length; i++)
    {
        print_vector(vecs[i]);
    }
}

int run()
{
    box<float3> a = float3(1.0, 2.0, 3.0);
    float3 b = float3(10.0, 20.0, 30.0);
    float3 sum = add(a, b);         // {11, 22, 33}
    float3 splat = float3(5.0);     // {5, 5, 5}
    float3 combo = sum + splat;     // {16, 27, 38}

    print_vectors(a, b, sum);

    // Testing of box simd
    box<float3> boxA = float3(1.0, 2.0, 3.0);
    box<float3> boxB = float3(4.0, 5.0, 6.0);
    box<float3> boxC = add(boxA, boxB);

    box<float3>[] vecs = { b };
    array_push(vecs, a);

    float3 sw = vecs[vecs.length - 1].zyx;              // swizzle {3, 2, 1}

    return (int)(combo.x + combo.y + combo.z)   // 16 + 27 + 38 = 81
         + (int)(sw.x + sw.y + sw.z);           // 3 + 2 + 1 = 6  => 87
}
