// expect: run
// expect-output: 5
// expect-output: 9 9
// expect-output: 20
// expect-output: 2 4
// expect-output: 40
// expect-output: 20 20
// expect-output: 7
// rule: `&place` yields a `*T` to the place, `*ptr` reads and writes the pointee, and `p.field` follows the pointer
struct Counter { uint n; int tag; }

void Bump(*Counter c)
{
    c.n = c.n + 1u;
    (*c).tag += 2;
}

void SetInt(*int p, int v)
{
    *p = v;
}

int main()
{
    int x = 5;
    *int p = &x;
    printf("%d\n", *p);
    *p = 9;
    printf("%d %d\n", x, *p);
    *p += 1;
    SetInt(p, *p * 2);
    printf("%d\n", x);

    Counter c;
    Bump(&c);
    Bump(&c);
    printf("%u %d\n", c.n, c.tag);

    *Counter cp = &c;
    cp.n = 40u;
    Counter copy = *cp;
    printf("%u\n", copy.n);

    int[3] arr = { 1; 3 };
    *int e = &arr[1];
    *e = 20;
    printf("%d %d\n", arr[1], *&x);

    **(&p) = 7;
    printf("%d\n", x);
    Report();
    return 0;
}
