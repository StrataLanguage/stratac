// expect: run
// rule: a value built by Init is a fresh owned value: it moves into arrays, boxes, optionals and fields and is dropped once
struct C { int n; };
impl C { void Init(ref C self, int n) { self.n = n; gLive++; } void Drop(ref C self) { gLive--; } }
struct Outer { C c; int k; };
C Make(int n) { return C(n); }
int main()
{
    {
        C[] arr = {};
        array_push(arr, C(7));
        ^C bx = C(8);
        C? o = C(9);
        Outer w = Outer { .c = C(10), .k = 1 };
        C m = Make(11);
    }
    Report();
    return 0;
}
