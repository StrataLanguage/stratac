// expect: run
// expect-output: drop 1
// expect-output: drop 2
// expect-output: b.r 3
// rule: a field assignment whose right side reassigns the owner through a ref stores into the new owner
struct Bag { ^Res r; int n; };
^Res Reset(ref ^Bag b) { b = Bag { .r = Box(2), .n = 1 }; return Box(3); }
int main()
{
    {
        ^Bag b = Bag { .r = Box(1), .n = 0 };
        b.r = Reset(b);
        printf("b.r %d n %d\n", b.r.id, b.n);
    }
    Report();
    return 0;
}
