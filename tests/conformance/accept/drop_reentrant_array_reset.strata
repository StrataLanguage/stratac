// expect: run
// rule: a Drop method that pushes into the array being reset runs cleanly and every element is dropped once
// xfail: hole 12, Drop re-entering the slot being dropped
struct Pusher { int id; };
struct Holder { Pusher[] items; };
^Holder gH = Holder { .items = {} };
Pusher P(int id) { gLive++; return Pusher { .id = id }; }
impl Pusher
{
    void Drop(ref Pusher self) { gLive--; if (self.id < 3) { for (int i = 0; i < 20; i++) { array_push(gH.items, P(1000 + i)); } } }
}
int main()
{
    array_push(gH.items, P(1));
    array_push(gH.items, P(2));
    gH.items = {};
    gH.items = {};
    Report();
    return 0;
}
