// expect: run
// expect-output: drop 1
// expect-output: len 1
// expect-output: drop 2
// expect-output: END live=0
// rule: a removed element that nobody keeps drops once; the array drops the rest when it is destroyed
int main()
{
    {
        Res[] list = {};
        array_push(list, Res.Make(1));
        array_push(list, Res.Make(2));
        array_swap_remove(list, 0u);
        printf("len %u\n", list.length);
    }
    Report();
    return 0;
}
