// expect: run
// expect-output: Z drop 0
// expect-output: drop 1
// expect-output: drop 2
// rule: a drop method that reassigns self drops the old fields on assignment and the new ones afterwards
struct Z { ^Res inner; int id; };
impl Z { void drop(ref Z self) { printf("Z drop %d\n", self.id); if (self.id == 0) { self = Z { .inner = Box(2), .id = 1 }; } } }
int main()
{
    {
        ^Z z = Z { .inner = Box(1), .id = 0 };
    }
    Report();
    return 0;
}
