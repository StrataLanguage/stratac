// expect: run
// expect-output: release 1
// expect-output: freed
// expect-output: freed
// rule: the meta plan example: a `release` call in a generic `*T` function is dropped for a type without `release`, and kept for one with it
@meta
bool releasable(type T)
{
    // Whether T's impl defines a method `release`.
    return @has_function(T, release);
}

struct Loud { int id; }
impl Loud { void release(ref Loud self) { printf("release %d\n", self.id); } }
struct Quiet { int id; }

void free_object<T>(*T ptr_value)
{
    if (@releasable(T))
    {
        ptr_value.release();
    }
    printf("freed\n");
}

int main()
{
    Loud l = Loud { .id = 1 };
    Quiet q = Quiet { .id = 2 };
    free_object<Loud>(&l);
    free_object<Quiet>(&q);
    return 0;
}
