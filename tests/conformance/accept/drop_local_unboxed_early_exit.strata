// rule: by-value Drop locals are dropped on return, break and continue, except one returned by move
struct V { int id; };
impl V { void Drop(ref V self) { gLive--; printf("drop %d\n", self.id); } }
V Mk(int id) { gLive++; return V { .id = id }; }
int Early(bool stop) { V a = Mk(1); if (stop) { return 1; } return 0; }
V Give() { V keep = Mk(4); V other = Mk(2); return keep; }
int main()
{
    Early(true);
    { V got = Give(); got = Mk(5); }
    for (int i = 0; i < 3; i++) { V l = Mk(3); if (i == 0) { continue; } break; }
    Report();
    return 0;
}
