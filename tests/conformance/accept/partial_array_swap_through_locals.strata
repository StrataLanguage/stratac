// expect: run
// expect-output: 2 1
// expect-output: END live=0
// rule: two elements swap by removing one and replacing the other with it
int main()
{
    {
        Res[] a = {};
        array_push(a, Res.Make(1));
        array_push(a, Res.Make(2));
        ^Res t1 = array_remove(a, 1u);
        ^Res t0 = array_replace(a, 0u, t1);
        array_push(a, t0);
        printf("%d %d\n", a[0].id, a[1].id);
    }
    Report();
    return 0;
}
