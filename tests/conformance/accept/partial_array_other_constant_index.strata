// rule: removing one element leaves the others in place; the array drops them normally
void F()
{
    Res[] list = {};
    array_push(list, Res.Make(1));
    array_push(list, Res.Make(2));
    ^Res x = array_remove(list, 0u);
    printf("read %d\n", list[0].id);
}
int main() { F(); Report(); return 0; }
