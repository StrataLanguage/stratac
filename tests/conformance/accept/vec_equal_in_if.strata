// expect: run
// expect-output: differ
// rule: a vector comparison is a bool and can be used directly as an if condition
int main()
{
    float4 b = float4(1.0, 2.0, 3.0, 4.0);
    float4 c = float4(1.0, 9.0, 9.0, 9.0);
    if (b == c) { printf("equal\n"); } else { printf("differ\n"); }
    return 0;
}
