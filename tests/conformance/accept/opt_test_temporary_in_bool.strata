// expect: run
// expect-output: b 1
// rule: x? on a temporary optional in an expression drops the temporary afterwards
// xfail: hole 14, x? on a temporary leaks
Res? Maybe(int i) { return Res.Make(i); }
int main()
{
    bool b = Maybe(2)?;
    printf("b %d\n", b ? 1 : 0);
    Report();
    return 0;
}
