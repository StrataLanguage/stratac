// expect: run
// expect-output: b.r 1 name 1
// expect-output: drop 1
// rule: copy() of a struct deep-copies its strings and shares its rc handles, so the copy outlives the original
struct S { rc<Res> r; string name; };
int main()
{
    {
        ^S a = S { .r = Res.Make(1), .name = copy("n") };
        ^S b = copy(a);
        drop(a);
        printf("b.r %d name %d\n", b.r.id, b.name == "n" ? 1 : 0);
    }
    Report();
    return 0;
}
