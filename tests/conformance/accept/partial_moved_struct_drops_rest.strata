// expect: run
// expect-output: took 1
// expect-output: drop 2
// rule: a struct with a field moved out drops only its remaining fields at scope end
struct Pair { ^Res a; ^Res b; };
void Take(^Res r) { printf("took %d\n", r.id); }
int main()
{
    {
        ^Pair p = Pair { .a = Box(1), .b = Box(2) };
        Take(p.a);
    }
    Report();
    return 0;
}
