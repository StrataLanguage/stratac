// expect: run
// expect-output: 3
// expect-output: 2.5
// expect-output: 7
// rule: a call to a generic function infers its type arguments from the declared types of its arguments
struct number<T> { T value; }
number<T> make_number<T>(T value)
{
    number<T> n = number<T> { .value = value };
    return n;
}
void show_int(int v) { printf("%d\n", v); }
void show_float(float v) { printf("%g\n", v); }
int twice<T>(T v) { return 7; }
int main()
{
    number<int> a = make_number(3);
    number<float> b = make_number(2.5f);
    show_int(a.value);
    show_float(b.value);
    int c = twice(1);
    show_int(c);
    return 0;
}
