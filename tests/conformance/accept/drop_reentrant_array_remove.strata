// expect: run
// rule: a Drop method that removes from the array it is being removed from runs cleanly and every element is dropped once
// xfail: hole 12, Drop re-entering the slot being dropped
struct Pusher { int id; };
struct Holder { Pusher[] items; };
^Holder gH = Holder { .items = {} };
int gSeen = 0;
Pusher P(int id) { gLive++; return Pusher { .id = id }; }
impl Pusher
{
    void Drop(ref Pusher self)
    {
        gLive--;
        if ((gSeen & (1 << self.id)) != 0) { strata_panic("dropped twice"); }
        gSeen = gSeen | (1 << self.id);
        if (self.id == 1) { array_remove(gH.items, 0); }
    }
}
int main()
{
    array_push(gH.items, P(1));
    array_push(gH.items, P(2));
    array_push(gH.items, P(3));
    array_remove(gH.items, 0);
    gH.items = {};
    Report();
    return 0;
}
