// expect: reject
// rule: a field may not be moved out through a ref parameter, since the caller would see it moved
// xfail: hole 2, take-without-refill through a ref param
struct Pair { ^Res a; ^Res b; };
void Take(^Res r) { printf("took %d\n", r.id); }
void Steal(ref Pair p) { Take(p.a); }
int main()
{
    ^Pair p = Pair { .a = Box(1), .b = Box(2) };
    Steal(p);
    printf("a %d\n", p.a.id);
    Report();
    return 0;
}
