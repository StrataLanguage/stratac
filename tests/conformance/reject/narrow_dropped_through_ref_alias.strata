// expect: reject
// rule: dropping an optional through a ref alias ends the narrowing of the original
struct T { Res? cur; };
int main()
{
    ^T t = T { };
    t.cur = Res.Make(1);
    ref T alias = t;
    if (t.cur?)
    {
        drop(alias.cur);
        printf("%d\n", t.cur.id);
    }
    return 0;
}
