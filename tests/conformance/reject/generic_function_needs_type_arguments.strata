// expect: reject "can't infer type argument 'T' of 'make_none': write 'make_none<...>(...)'"
// rule: a type parameter that no argument's type fixes (here it is only in the result) must be written at the call
struct number<T> { T value; }
number<T> make_none<T>()
{
    number<T> n = number<T> { .value = 0 };
    return n;
}
int main()
{
    number<int> n = make_none();
    return 0;
}
