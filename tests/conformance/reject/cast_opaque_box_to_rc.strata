// expect: reject
// rule: a box cannot be cast through an opaque struct into an rc handle
// xfail: hole 17, box casts through an opaque struct are unchecked
struct Opaque;
int main()
{
    {
        ^Res b = Box(11);
        ^Opaque o = (^Opaque)b;
        rc<Res> r = (rc<Res>)o;
        printf("%d\n", r.id);
    }
    Report();
    return 0;
}
