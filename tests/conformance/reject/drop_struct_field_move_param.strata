// expect: reject
// rule: a field cannot be moved out of a by-value parameter whose type has a Drop method
struct Z { ^Res inner; int id; };
impl Z { void Drop(ref Z self) { printf("Z drop sees inner %d\n", self.inner.id); } }
^Res Take(^Z z) { return z.inner; }
int main()
{
    {
        ^Z z = Z { .inner = Box(1), .id = 0 };
        ^Res r = Take(z);
    }
    Report();
    return 0;
}
