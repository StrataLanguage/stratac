// expect: reject
// rule: a push through one rc handle invalidates refs taken through another handle to the same cell
// xfail: hole 4, refs are not invalidated through other rc handles
struct Cell { Res[] items; };
int main()
{
    rc<Cell> a = Cell { .items = {} };
    array_push(a.items, Res.Make(1));
    rc<Cell> b = a;
    ref Res r = a.items[0];
    for (int k = 0; k < 64; k++) { array_push(b.items, Res.Make(10 + k)); }
    printf("%d\n", r.id);
    return 0;
}
