// expect: reject "cannot move out of"
// rule: an element cannot be moved out of its array, so the array stays whole; use array_remove or array_replace
int Sum(Res[] l) { int s = 0; for (uint k = 0u; k < l.length; k++) { s += l[k].id; } return s; }
int main()
{
    Res[] list = {};
    array_push(list, Res.Make(1));
    array_push(list, Res.Make(2));
    uint i = 0u;
    ^Res x = list[i];
    printf("sum %d\n", Sum(list));
    Report();
    return 0;
}
