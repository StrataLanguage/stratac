// expect: reject "used after move"
// rule: assigning a by-value owning local to another moves it, also when its type is named through an alias
struct S { string s; };
struct SA = S;
int main()
{
    SA a;
    a.s = "allocated string payload";
    SA b;
    b = a;
    printf("[%s] [%s]\n", (cstring)a.s, (cstring)b.s);
    return 0;
}
