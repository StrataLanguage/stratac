// expect: reject
// rule: dropping an optional field through one rc handle ends its narrowing through every other handle to the cell
// xfail: hole 4, narrowing is not ended through other rc handles
struct T { Res? cur; };
int main()
{
    rc<T> a = T { };
    a.cur = Res.Make(1);
    rc<T> b = a;
    if (a.cur?)
    {
        drop(b.cur);
        printf("%d\n", a.cur.id);
    }
    return 0;
}
