// expect: reject
// rule: a ref to a box cell and a ref to its owning box may not be passed to the same call
struct Cell { Res[] items; };
int Peek(ref Cell c, ref ^Cell owner) { owner = Cell { .items = {} }; return c.items[0].id; }
int main()
{
    ^Cell a = Cell { .items = {} };
    array_push(a.items, Res.Make(1));
    ref Cell c = a;
    printf("%d\n", Peek(c, a));
    return 0;
}
