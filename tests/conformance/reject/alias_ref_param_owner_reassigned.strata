// expect: reject
// rule: a ref to an rc cell and a ref to its owning handle may not be passed to the same call
struct Cell { Res[] items; };
int Peek(ref Cell c, ref rc<Cell> owner) { owner = Cell { .items = {} }; return c.items[0].id; }
int main()
{
    rc<Cell> a = Cell { .items = {} };
    array_push(a.items, Res.Make(1));
    ref Cell c = a;
    printf("%d\n", Peek(c, a));
    return 0;
}
