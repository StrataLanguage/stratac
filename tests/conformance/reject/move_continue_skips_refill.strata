// expect: reject "used after move"
// rule: a continue that skips the refill leaves the variable moved on the next iteration
void Take(^Res r) { printf("took %d\n", r.id); }
int main()
{
    ^Res a = Box(1);
    for (int i = 0; i < 3; i++)
    {
        Take(a);
        if (i == 0) { continue; }
        a = Box(2);
    }
    Report();
    return 0;
}
