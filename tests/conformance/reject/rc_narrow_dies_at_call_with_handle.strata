// expect: reject
// rule: passing an rc handle to a function that clears a field ends the narrowing of that field
// xfail: hole 4, narrowing is not ended when the cell changes through another handle
struct T { Res? cur; };
void Clear(rc<T> t) { drop(t.cur); }
int main()
{
    rc<T> a = T { };
    a.cur = Res.Make(1);
    if (a.cur?)
    {
        Clear(a);
        printf("%d\n", a.cur.id);
    }
    return 0;
}
