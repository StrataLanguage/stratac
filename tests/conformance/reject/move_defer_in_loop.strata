// expect: reject "used after move"
// rule: a deferred move inside a loop body runs at the end of every iteration
void Take(^Res r) { printf("took %d\n", r.id); }
int main()
{
    ^Res a = Box(1);
    for (int i = 0; i < 3; i++)
    {
        defer Take(a);
        if (i == 0) { continue; }
    }
    Report();
    return 0;
}
