// expect: reject "cannot move 'h.a' out on its own"
// rule: a field holding a Drop value by value only moves with its parent; nothing marks the storage it would leave
struct Inner { int id; };
impl Inner { void Drop(ref Inner self) { printf("inner drop %d\n", self.id); } }
struct H { Inner a; int n; };
int main()
{
    ^H h = H { .a = Inner { .id = 7 }, .n = 1 };
    ^Inner x = h.a;
    return 0;
}
