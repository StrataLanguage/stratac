// expect: reject "cannot move out of"
// rule: an element cannot be moved out of its array, even if another slot is refilled; use array_replace
int main()
{
    Res[] list = {};
    array_push(list, Res.Make(1));
    array_push(list, Res.Make(2));
    ^Res x = list[0];
    list[1] = Res.Make(9);
    printf("read %d\n", list[0].id);
    Report();
    return 0;
}
