// expect: reject
// rule: drop(g) runs g's drop, which may grow a global array, so refs into it are invalidated
struct Holder { Res[] list; };
struct Grower { int id; };
^Holder gH = Holder { .list = {} };
impl Grower { void drop(ref Grower self) { for (int i = 0; i < 64; i++) { array_push(gH.list, Res.Make(500 + i)); } } }
int main()
{
    array_push(gH.list, Res.Make(1));
    ^Grower g = Grower { .id = 0 };
    ref Res first = gH.list[0];
    drop(g);
    printf("first %d\n", first.id);
    return 0;
}
