// expect: reject
// rule: a field cannot be moved out of a struct that has a drop method, since drop expects every field
struct Z { ^Res inner; int id; };
impl Z { void drop(ref Z self) { printf("Z drop sees inner %d\n", self.inner.id); } }
int main()
{
    {
        ^Z z = Z { .inner = Box(1), .id = 0 };
        ^Res t = z.inner;
    }
    Report();
    return 0;
}
