// expect: reject "cannot move out of"
// rule: an element cannot be moved out of its array, even if the slot would be refilled; use array_replace
int main()
{
    Res[] list = {};
    array_push(list, Res.Make(1));
    array_push(list, Res.Make(2));
    uint i = 0u;
    ^Res x = list[i];
    i = 1u;
    list[i] = Res.Make(9);
    printf("read %d\n", list[0].id);
    Report();
    return 0;
}
