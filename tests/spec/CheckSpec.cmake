# Roadmap phase 2 gate: every conformance glob named in docs/spec/*.md matches at least one case.
# Run with -DROOT=<repo root>.
file(GLOB specs "${ROOT}/docs/spec/*.md")
set(failed FALSE)
set(gaps 0)

foreach(spec ${specs})
    file(STRINGS "${spec}" lines)
    foreach(line ${lines})
        if(NOT line MATCHES "^\\| O[0-9]+ \\|")
            continue()
        endif()
        string(REPLACE ";" "," line "${line}")
        string(REPLACE "|" ";" cells "${line}")
        list(LENGTH cells n)
        list(GET cells 1 id)
        string(STRIP "${id}" id)
        list(GET cells 3 acceptCell)
        list(GET cells 4 rejectCell)
        foreach(kind accept reject)
            set(cell "${${kind}Cell}")
            string(STRIP "${cell}" cell)
            if(cell STREQUAL "-")
                math(EXPR gaps "${gaps}+1")
                continue()
            endif()
            string(REGEX MATCHALL "`[^`]+`" globs "${cell}")
            foreach(g ${globs})
                string(REPLACE "`" "" g "${g}")
                file(GLOB matched "${ROOT}/tests/conformance/${kind}/${g}.strata")
                if(NOT matched)
                    message(SEND_ERROR "${id}: no ${kind} case matches ${g}")
                    set(failed TRUE)
                endif()
            endforeach()
        endforeach()
    endforeach()
endforeach()

message(STATUS "spec rules without a case: ${gaps}")
