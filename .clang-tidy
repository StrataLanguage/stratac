---
# Strata C++ lint config (clang-tidy 22+).
#
# Usage:
#   clang-tidy -p build/default src/Lex/Lexer.cpp
#   clang-tidy -p build/default --fix src/Lex/Lexer.cpp   (apply fixes)
#
# `-p` points at compile_commands.json. Generate it by enabling
# CMAKE_EXPORT_COMPILE_COMMANDS in the CMake configure step; ccache/Ninja
# presets already use the Ninja generator which writes it to build/default.
#
# Naming conventions enforced by readability-identifier-naming:
#   - Free functions and methods:  PascalCase  (e.g. SkipWhitespace)
#   - Private/protected members:   m_ + camelCase (e.g. m_pos)
#   - Parameters / locals:         camelCase
#   - Types / enums / enum constants: PascalCase
#   - Namespaces:                  lower_case
# The public C ABI (strata.h: strataJit*, strataCompiler*, ...) intentionally
# keeps a camelCase, C-friendly spelling and is exempted via
# FunctionIgnoredRegexp below, as is `main`.

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-no-int-to-ptr,
  -modernize-avoid-c-arrays,
  -modernize-macro-to-enum,
  -modernize-use-default-member-init,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -performance-no-int-to-ptr,
  -readability-braces-around-statements,
  -readability-else-after-return,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-non-const-parameter,
  -readability-simplify-boolean-expr,
  -readability-suspicious-call-argument,
WarningsAsErrors: ''
HeaderFilterRegex: 'strata'
FormatStyle: file

CheckOptions:
  # ---- Functions / methods: PascalCase ----
  - key:             readability-identifier-naming.FunctionCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionIgnoredRegexp
    value:           '^strata[A-Z]|^main$'
  - key:             readability-identifier-naming.MethodCase
    value:           CamelCase

  # ---- Private / protected data members: m_ + camelCase ----
  - key:             readability-identifier-naming.PrivateMemberPrefix
    value:           'm_'
  - key:             readability-identifier-naming.PrivateMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.ProtectedMemberPrefix
    value:           'm_'
  - key:             readability-identifier-naming.ProtectedMemberCase
    value:           camelBack

  # ---- Parameters / locals / constants: camelCase ----
  - key:             readability-identifier-naming.ParameterCase
    value:           camelBack
  - key:             readability-identifier-naming.ConstantParameterCase
    value:           camelBack
  - key:             readability-identifier-naming.LocalVariableCase
    value:           camelBack

  # ---- Types: PascalCase ----
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeAliasCase
    value:           CamelCase

  # ---- Namespaces: lower_case ----
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
