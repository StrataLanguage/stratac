import bit;

T min<T>(const T x, const T y)
{
	if (x <= y) {
		return x;
	}

	return y;
}

T max<T>(const T x, const T y)
{
	if (x >= y) {
		return x;
	}

	return y;
}

T clamp<T>(T x, const T lower_bound, const T upper_bound)
{
	if (x < lower_bound) {
		return lower_bound;
	}
	if (x > upper_bound) {
		return upper_bound;
	}

	return x;
}

T hypot<T>(const T a, const T b)
{
	return (a * a) + (b * b);
}

@private
uint __typetobits<T>(T x)
{
	return bitcast<T, uint>(x);
}

@private
T __bitstotype<T>(uint bits)
{
	return bitcast<uint, T>(bits);
}

float abs(float x)
{
	const uint bits = __typetobits<float>(x);
	return __bitstotype<float>((bits & 0x7FFFFFFF));
}

int abs(int x)
{
	const int mask = (x >> 31);
	return (x + mask) ^ mask;
}

float sign(float x)
{
	// Get the sign bit for the float and apply it to 1.0 if it is set.
	return __bitstotype<float>((__typetobits<float>(1.0f) | (__typetobits<float>(x) & (uint)0x80000000)));
}


/* Generic case. Aligns a value to a given alignment (i.e. aligning 10 to 16 would result in 16.) */
ulong align_value(ulong value_, ulong align_)
{
	const ulong rem = (value_ % align_);

	if (rem != 0) {
		value_ += (align_ - rem);
	}

	return value_;
}

ulong align_value_16(ulong value_)
{
	const ulong rem = (value_ & (ulong)0x0F);

	if (rem != 0) {
		value_ += (16 - rem);
	}

	return value_;
}
