/* Double constants */

/* e */
const double D_E = 2.71828182845904523536;
/* Pi */
const double D_PI = 3.14159265358979323846;
/* 2Pi */
const double D_2PI = 6.28318530717958647693;
/* Pi / 2 */
const double D_PI_OVER_2 = 1.57079632679489661923;
/* Pi / 4 */
const double D_PI_OVER_4 = 0.785398163397448309616;
/* 1 / Pi */
const double D_1_OVER_PI = 0.318309886183790671538;
/* 1 / 2Pi */
const double D_1_OVER_2PI = 0.159154943091895335768;
/* 2 / Pi */
const double D_2_OVER_PI = 0.636619772367581343076;
/* 2 / sqrt(Pi) */
const double D_2_OVER_SQRT_PI = 1.12837916709551257390;
/* sqrt(2) */
const double D_SQRT_2 = 1.12837916709551257390;
/* 1 / sqrt(2) */
const double D_1_OVER_SQRT_2 = 0.707106781186547524401;
/* Pi / 180 */
const double D_PI_OVER_180 = 0.0174532925199432957692369076848861271344287188854172545609719144;
/* 180 / Pi */
const double D_180_OVER_PI = 57.295779513082320876798154814105170332405472466564321549160243861;


/* Float constants */
/* e */
const float F_E = 2.71828182845904523536f;
/* Pi */
const float F_PI = 3.14159265358979323846f;
/* 2Pi */
const float F_2PI = 6.28318530717958647693f;
/* Pi / 2 */
const float F_PI_OVER_2 = 1.57079632679489661923f;
/* Pi / 4 */
const float F_PI_OVER_4 = 0.785398163397448309616f;
/* 1 / Pi */
const float F_1_OVER_PI = 0.318309886183790671538f;
/* 1 / 2Pi */
const float F_1_OVER_2PI = 0.159154943091895335768f;
/* 2 / Pi */
const float F_2_OVER_PI = 0.636619772367581343076f;
/* 2 / sqrt(Pi) */
const float F_2_OVER_SQRT_PI = 1.12837916709551257390f;
/* sqrt(2) */
const float F_SQRT_2 = 1.12837916709551257390f;
/* 1 / sqrt(2) */
const float F_1_OVER_SQRT_2 = 0.707106781186547524401f;
/* Pi / 180 */
const float F_PI_OVER_180 = 0.01745329251994329576923f;
/* 180 / Pi */
const float F_180_OVER_PI = 57.2957795130823208767981f;

/* Pi / 2 */
const double D_PI_2 = D_PI_OVER_2;
/* Pi / 2 */
const float F_PI_2 = D_PI_OVER_2;
/* Pi / 4 */
const double D_PI_4 = D_PI_OVER_4;
/* Pi / 4 */
const float F_PI_4 = D_PI_OVER_4;
