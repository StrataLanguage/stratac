import metautil;

@export extern *void malloc(ulong size);
@export extern *void realloc(*void p, ulong size);
@export extern void free(*void p);

@export extern *void memcpy(*void dst, const *void src, ulong count);



*void memory_alloc(ulong size)
{
	return malloc(size);
}

void memory_free(*void p)
{
	free(p);
}


*T object_alloc<T>()
{
	*T _ptr = (*T)memory_alloc(sizeof(T));

	if (@initable(T)) {
		_ptr.init();
	}

	return _ptr;
}

void object_free<T>(*T _ptr)
{
	if (@droppable(T)) {
		_ptr.drop();
	}

	memory_free((*void)_ptr);
}


*T memory_copy<T>(*T dst, const *T src, ulong count)
{
	return (*T)memcpy((*void)dst, (*void)src, count);
}
