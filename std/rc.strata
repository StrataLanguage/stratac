import metautil;
import math;

import memory;

struct __refcnt
{
	uint count;
}

impl __refcnt
{
	void init(ref self)
	{
		self.count = 1;
	}

	void inc(ref self)
	{
		++self.count;
	}

	uint dec(ref self)
	{
		--self.count;
		return (self.count);
	}
}

/* Ref counted pointer container.
 *
 * The value and its count share one allocation. `T` may own memory or have a drop method: the last handle to go
 * runs its drop glue in place (ptr_drop) before the memory is freed. Reach the value through `ptr` (fields and
 * `ref` / `const ref` methods), or `get()`; it is never moved out.
 */
struct rc<T>
{
	*T ptr;
	*__refcnt refcnt;
}

impl rc<T>
{
	void init(ref self)
	{
		self.ptr = null;
		self.refcnt = null;
	}

	// Shares `other`'s value: one more handle on the same count.
	void init(ref self, const ref rc<T> other)
	{
		self.ptr = other.ptr;
		self.refcnt = other.refcnt;

		if (self.refcnt != null) {
			self.refcnt.inc();
		}
	}

	// Builds a fresh value for this handle, releasing what it held. A `T` with an init is constructed from
	// `args`; any other `T` takes the one value to move in (`make_ref<string>("text")`).
	void create_ref<TArgs...>(ref self, TArgs... args)
	{
		self.__decref();

		// Pad the size out so our total allocation is aligned
		const ulong aligned_size = align_value_16(sizeof<T>());
		*byte raw_alloc = (*byte)memory_alloc(aligned_size + sizeof<__refcnt>());

		*T obj_ptr = (*T)raw_alloc;

		if (@initable(T)) {
			obj_ptr.init(args...);
		} else {
			ptr_place(obj_ptr, args...);
		}

		*__refcnt refcnt = (*__refcnt)(ptr)((ulong)raw_alloc + aligned_size);
		refcnt.init();

		self.ptr = obj_ptr;
		self.refcnt = refcnt;
	}

	*T get(const ref self)
	{
		return self.ptr;
	}

	bool is_set(const ref self)
	{
		return self.ptr != null;
	}

	uint use_count(const ref self)
	{
		if (self.refcnt == null) {
			return 0;
		}

		return self.refcnt.count;
	}

	@private
	void __decref(ref self)
	{
		if (self.refcnt == null) {
			return;
		}

		if (self.refcnt.dec() == 0) {
			// The last handle: end the value, then free the combined allocation (value and count).
			ptr_drop(self.ptr);
			memory_free((*void)(ptr)self.ptr);
		}

		self.ptr = null;
		self.refcnt = null;
	}

	void drop(ref self)
	{
		self.__decref();
	}
}

rc<T> make_ref<T, TArgs...>(TArgs... args)
{
	rc<T> res;
	res.create_ref(args...);
	return res;
}
