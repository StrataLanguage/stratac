import metautil;
import math;

import memory;

extern int printf(cstring fmt, ...);

struct __refcnt
{
	uint count;
}

impl __refcnt
{
	void init(ref __refcnt self)
	{
		self.count = 1;
	}

	void inc(ref __refcnt self)
	{
		++self.count;
	}

	uint dec(ref __refcnt self)
	{
		--self.count;
		return (self.count);
	}
}

/* Ref counted pointer container */
struct rc<T>
{
	*T ptr;
	*__refcnt refcnt;
}

impl rc<T>
{
	void init(ref rc<T> self)
	{
		self.ptr = null;
		self.refcnt = null;
	}

	void init<TArgs...>(ref rc<T> self, TArgs... args)
	{
		self.create_ref(args...);
	}

	@private
	void create_ref<TArgs...>(ref rc<T> self, TArgs... args)
	{
		// Pad the size out so our total allocation is aligned
		const ulong aligned_size = align_value_16(sizeof<T>());
		*byte raw_alloc = (*byte)memory_alloc(aligned_size + sizeof<__refcnt>());

		*T obj_ptr = (*T)raw_alloc;
		obj_ptr.init(args...);

		ptr refcnt_raw = (ptr)((ulong)raw_alloc + aligned_size);

		self.ptr = obj_ptr;
		self.refcnt = (*__refcnt)refcnt_raw;

		printf("Creating rc\n");
	}

	@private
	void decref(ref rc<T> self)
	{
		if (self.refcnt == null) {
			return;
		}

		if (self.refcnt.dec() == 0) {
			printf("Destroying rc\n");
		}
	}

	void drop(ref rc<T> self)
	{
		self.decref();
	}
}

rc<T> make_ref<T, TArgs...>(TArgs... args)
{
	var res = rc<T>();
	res.create_ref();
	res.ptr.init(args...);
	return res;
}
