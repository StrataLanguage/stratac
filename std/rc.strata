import metautil;
import math;

import memory;

extern int printf(cstring fmt, ...);

struct __refcnt
{
	uint count;
}

impl __refcnt
{
	void init(ref __refcnt self)
	{
		self.count = 1;
	}

	void inc(ref __refcnt self)
	{
		++self.count;
	}

	uint dec(ref __refcnt self)
	{
		--self.count;
		return (self.count);
	}
}

/* Ref counted pointer container */
struct rc<T>
{
	*T ptr;
	*__refcnt refcnt;
}





impl rc<T>
{
	void init(ref rc<T> self)
	{
		self.ptr = null;
		self.refcnt = null;
	}

	void init(ref rc<T> self, const ref rc<T> other)
	{
		self.ptr = other.ptr;
		self.refcnt = other.refcnt;

		if (self.refcnt != null) {
			self.refcnt.inc();
		}
	}

	void init(ref rc<T> self, const ref T value)
	{
		self.create_ref<T>(value);
	}

	void create_ref<TArgs...>(ref rc<T> self, TArgs... args)
	{
		// Pad the size out so our total allocation is aligned
		const ulong aligned_size = align_value_16(sizeof<T>());
		*byte raw_alloc = (*byte)memory_alloc(aligned_size + sizeof<__refcnt>());

		*T obj_ptr = (*T)raw_alloc;

		if (@initable(T)) {
			obj_ptr.init(args...);
		}
		else if (args.length == 1) {
			(*obj_ptr) = args[0];
		}

		*__refcnt refcnt = (*__refcnt)(ptr)((ulong)raw_alloc + aligned_size);
		refcnt.init();

		self.ptr = obj_ptr;
		self.refcnt = refcnt;
	}

	// T get(ref rc<T> self)
	// {
	// 	return (*self.ptr);
	// }

	@private
	void __decref(ref rc<T> self)
	{
		if (self.refcnt == null) {
			return;
		}

		if (self.refcnt.dec() == 0) {
			ptr raw_ptr = (ptr)self.ptr;
			memory_free((*void)raw_ptr);

			self.ptr = null;
			// This is a combined allocation, so refcnt is already freed
			self.refcnt = null;
		}
	}

	void drop(ref rc<T> self)
	{
		self.__decref();
	}
}

rc<T> make_ref<T, TArgs...>(TArgs... args)
{
	rc<T> res;
	res.create_ref(args...);
	return res;
}
