{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Strata",
  "scopeName": "source.strata",
  "fileTypes": ["strata"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#import" },
    { "include": "#attributes" },
    { "include": "#type-declarations" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#user-types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#block-comment" },
        {
          "name": "comment.line.double-slash.strata",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.strata" } },
          "end": "$"
        }
      ]
    },
    "block-comment": {
      "comment": "Block comments nest (see Lexer.c).",
      "name": "comment.block.strata",
      "begin": "/\\*",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.strata" } },
      "end": "\\*/",
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.strata" } },
      "patterns": [{ "include": "#block-comment" }]
    },
    "import": {
      "match": "\\b(import)\\s+([A-Za-z_./][\\w./]*)",
      "captures": {
        "1": { "name": "keyword.control.import.strata" },
        "2": { "name": "entity.name.namespace.strata" }
      }
    },
    "attributes": {
      "match": "(@)([A-Za-z_]\\w*)",
      "captures": {
        "0": { "name": "meta.attribute.strata" },
        "1": { "name": "punctuation.definition.annotation.strata" },
        "2": { "name": "storage.type.annotation.strata" }
      }
    },
    "type-declarations": {
      "patterns": [
        {
          "comment": "struct Foo / union Foo / enum Foo / impl Foo / namespace foo",
          "match": "\\b(struct|union|enum|impl|namespace)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.$1.strata" },
            "2": { "name": "entity.name.type.strata" }
          }
        },
        {
          "comment": "`handle` is contextual: handle Entity; / handle Entity : Base;",
          "match": "^\\s*(handle)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.handle.strata" },
            "2": { "name": "entity.name.type.strata" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.strata",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.strata" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.strata" } },
      "patterns": [
        { "name": "constant.character.escape.strata", "match": "\\\\[\\\\\"'ntr0]" },
        { "name": "invalid.illegal.escape.strata", "match": "\\\\." },
        { "name": "constant.other.placeholder.strata", "match": "%[-+ #0]*(\\d+|\\*)?(\\.(\\d+|\\*))?(hh|h|ll|l|z|j|t|L)?[diouxXeEfFgGaAcspn%]" }
      ]
    },
    "chars": {
      "name": "string.quoted.single.strata",
      "match": "'(?:\\\\[\\\\\"'ntr0]|[^'\\\\])'",
      "captures": { "0": { "patterns": [{ "name": "constant.character.escape.strata", "match": "\\\\." }] } }
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.strata", "match": "\\b0[xX][0-9a-fA-F]+(?:[uU][lL]?|[lL])?\\b" },
        { "name": "constant.numeric.float.strata", "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?[fF]?\\b" },
        { "name": "constant.numeric.float.strata", "match": "\\b\\d+[eE][+-]?\\d+[fF]?\\b" },
        { "name": "constant.numeric.integer.strata", "match": "\\b\\d+(?:[uU][lL]?|[lL]|[fF])?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.strata", "match": "\\b(if|else|while|for|break|continue|return|defer)\\b" },
        { "name": "storage.type.strata", "match": "\\b(struct|union|enum|impl|delegate|namespace|property)\\b" },
        { "name": "storage.modifier.strata", "match": "\\b(ref|const|static|extern|fieldoffset)\\b" },
        { "name": "keyword.other.strata", "match": "\\b(sizeof)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.strata",
          "match": "\\b(void|bool|int|uint|long|ulong|byte|sbyte|short|ushort|float|double|float2|float3|float4|string|cstring)\\b"
        },
        { "name": "support.type.builtin.strata", "match": "\\b(ptr|rc)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.strata", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.language.self.strata", "match": "\\bself\\b" },
        {
          "comment": "ALL_CAPS identifiers read as constants",
          "name": "constant.other.strata",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.strata",
      "match": "\\b(array_push|drop)\\b(?=\\s*\\()"
    },
    "functions": {
      "comment": "Any identifier followed by `(` is a call or a declaration; keywords and types are matched first.",
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.strata" } }
    },
    "user-types": {
      "comment": "Heuristic: PascalCase identifiers not followed by `(` are types.",
      "name": "entity.name.type.strata",
      "match": "\\b[A-Z]\\w*\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.variadic.strata", "match": "\\.\\.\\." },
        { "name": "keyword.operator.arrow.strata", "match": "->" },
        { "name": "keyword.operator.assignment.compound.strata", "match": "(\\+|-|\\*|/|%)=" },
        { "name": "keyword.operator.comparison.strata", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.strata", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.increment.strata", "match": "\\+\\+|--" },
        { "name": "keyword.operator.bitwise.shift.strata", "match": "<<|>>" },
        { "name": "keyword.operator.box.strata", "match": "\\^(?=\\s*[A-Za-z_(])" },
        { "name": "keyword.operator.optional.strata", "match": "\\?" },
        { "name": "keyword.operator.assignment.strata", "match": "=" },
        { "name": "keyword.operator.arithmetic.strata", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.bitwise.strata", "match": "&|\\||\\^|~" },
        { "name": "keyword.operator.comparison.strata", "match": "<|>" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.strata", "match": ";" },
        { "name": "punctuation.separator.comma.strata", "match": "," },
        { "name": "punctuation.accessor.strata", "match": "\\." },
        { "name": "punctuation.separator.colon.strata", "match": ":" }
      ]
    }
  }
}
